# Optional: Vercel AI Gateway model for personalized ranking.
AI_RANKING_MODEL=google/gemini-2.5-flash-lite
# Optional: DeepSeek model for budgeted final ranking of the shared Global Discovery Feed.
AI_DAILY_RANKING_MODEL=deepseek/deepseek-v4.1-flash
# Optional: override the Vercel AI Gateway model used for conditional official-evidence extraction.
AI_EVIDENCE_MODEL=deepseek/deepseek-v4.1-flash
# Leave these unset to keep model ranking and evidence enrichment disabled. Set all three only
# after reviewing the fixed scorecard and explicitly approving its exact scorecard ID.
